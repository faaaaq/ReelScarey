# Set this to the immutable sha tag or digest supplied with the tested release.
REELSCAREY_IMAGE=faaaaq/reelscarey:0.32.0
# Optional: expose the built-in qBittorrent peer port on a different host port.
# REELSCAREY_QBT_PORT=6881
# Optional: set to false together with a writable download folder (for example
# `install -d -o 10001 -g 10001 "$DOWNLOADS_PATH/builtin"`) before enabling the
# built-in qBittorrent client on the Download clients page.
# DOWNLOADS_READ_ONLY=false
# Replace these example addresses with your Ubuntu server's LAN address.
REELSCAREY_BIND_IP=192.168.1.20
REELSCAREY_PORT=8787
REELSCAREY_PUBLIC_URL=http://192.168.1.20:8787
# Start with dedicated test folders. The container runs as UID/GID 10001.
MEDIA_PATH=/srv/reelscarey-test/media
DOWNLOADS_PATH=/srv/reelscarey-test/downloads