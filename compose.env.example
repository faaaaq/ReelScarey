# Example environment for a disposable live-testing installation.
# Copy to live.env and adjust, then use:
#   docker compose --env-file live.env -f compose.yaml up -d

# Use :latest to follow the newest release, or pin a version tag/digest.
REELSCAREY_IMAGE=faaaaq/reelscarey:latest
# Replace these with your server's LAN address.
REELSCAREY_BIND_IP=192.168.1.20
REELSCAREY_PORT=8787
REELSCAREY_PUBLIC_URL=http://192.168.1.20:8787
TZ=America/Chicago

# Start with dedicated test folders. The container runs as UID/GID 10001.
# Imports use verified copies; only ReelScarey's own builtin folders are written.
CONFIG_PATH=/srv/reelscarey-test/config
MEDIA_PATH=/srv/reelscarey-test/media
DOWNLOADS_PATH=/srv/reelscarey-test/downloads
# Optional single writable parent for hardlink imports (see compose.yaml).
# DATA_PATH=/srv/reelscarey-test/data

# Optional VPN support for the built-in torrent client. Requires the compose
# cap_add NET_ADMIN block; a /dev/net/tun device is not needed.
# REELSCAREY_KEEP_NET_ADMIN=1
