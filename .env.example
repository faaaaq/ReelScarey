# Compose host paths; YouTube uses a separate writable staging volume.
MEDIA_PATH=./media
DOWNLOADS_PATH=./downloads
REELSCAREY_PORT=8787
# Version reported by builds from this checkout.
REELSCAREY_VERSION=0.22.0-dev
REELSCAREY_LOG_LEVEL=info
# For an explicit host or HTTPS reverse proxy, set the browser origin.
# Keep the default loopback port binding for local use.
REELSCAREY_PUBLIC_URL=
