# Copy to .env and adjust. Every value here has a working default except
# REELSCAREY_PUBLIC_URL, which must be the exact address you open in a browser.

# The three folders ReelScarey needs. Point them at your host paths.
CONFIG_PATH=./config
MEDIA_PATH=./media
DOWNLOADS_PATH=./downloads

# Optional single writable parent for hardlink imports (see compose.yaml).
# DATA_PATH=./data

# Linux account the container runs as after startup. Set these to the host
# account that owns your mounted library and download folders; a mismatch means
# the container cannot write imports into them. The container init script
# chowns the private config/backups/staging folders to PUID:PGID, but it never
# changes ownership of media or downloads — those must already match on the host.
PUID=10001
PGID=10001

# Calendar/date comparisons and scheduled times use this server timezone.
TZ=America/Chicago

# Loopback-only by default. Set an explicit host or reverse-proxy origin here.
REELSCAREY_BIND_IP=127.0.0.1
REELSCAREY_PORT=8787
REELSCAREY_PUBLIC_URL=

# Optional: pin a release instead of following :latest.
# REELSCAREY_IMAGE=faaaaq/reelscarey:0.54.10
# Version reported by builds from this checkout. Only used when building a
# local image (docker build); docker compose up never builds.
#REELSCAREY_VERSION=0.54.10

REELSCAREY_LOG_LEVEL=info
# Optional read-only browser roots; mount these folders into the container too.
REELSCAREY_BROWSE_ROOTS=
